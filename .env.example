# Never commit a funded private key. Use a disposable Monad Testnet-only account.
MONAD_PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY
# Optional override. Defaults to the official public Monad Testnet endpoint.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Public value used by the Next.js client. This is safe to commit.
NEXT_PUBLIC_BLUFF_CONTRACT_ADDRESS=0xAe3f56228405Eb3DACf7c2eE0991511900ef1BC4
